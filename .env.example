# TRISTARC Frontend Environment Variables
# Copy this file to .env.local and fill in values

# API Base URL (will point to Node.js/Express backend in Phase 2)
VITE_API_URL=http://localhost:5000/api

# App Configuration
VITE_APP_NAME=TRISTARC
VITE_APP_URL=http://localhost:5173

# Phase 2: These keys will be added when backend is ready
# DO NOT add database credentials, Supabase service role keys,
# JWT secrets, SMTP passwords, or any private backend credentials here.
